{
  "name": "chimeway",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A team messaging workspace with channels, threads, reactions, and AI summaries.",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:db": "vitest run supabase/tests",
    "verify": "npm run typecheck && npm run lint && npm run test",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:push": "supabase db push",
    "db:diff": "supabase db diff",
    "db:types": "supabase gen types typescript --local > database.generated.ts",
    "functions:serve": "supabase functions serve ai --env-file supabase/.env.local",
    "functions:deploy": "supabase functions deploy ai",
    "audit:secrets": "node scripts/audit-secrets.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.118.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.12",
    "@eslint/js": "10.0.1",
    "@tailwindcss/typography": "0.5.20",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "22.14.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.1.0",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "jsdom": "30.1.3",
    "tailwindcss": "4.3.3",
    "typescript": "5.8.3",
    "typescript-eslint": "8.72.1",
    "vite": "6.4.5",
    "vitest": "5.0.5"
  }
}
