# Chimeway client configuration.
#
# Both values come from your Supabase dashboard:
#   Project Settings -> API
#
# The anon key is meant to be public. It identifies the project and grants no
# access by itself: every read and write is checked by row level security in
# the database. Shipping it in the browser bundle is the intended design.
#
# NEVER put the service_role key here. It bypasses row level security entirely,
# and anything in a VITE_ variable is readable by every visitor.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# ---------------------------------------------------------------------------
# Server-side secrets (NOT here)
# ---------------------------------------------------------------------------
#
# The Gemini key belongs to the edge function, not the client. Set it with:
#
#   supabase secrets set GEMINI_API_KEY=...
#
# For local function development, put it in supabase/.env.local, which is
# gitignored and never bundled:
#
#   GEMINI_API_KEY=...
#   ALLOWED_ORIGINS=http://localhost:3000
